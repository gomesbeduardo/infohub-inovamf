  email                    String                     @unique(map: "uq_usuarios_email") @db.VarChar(255)
  senha                    String                     @db.VarChar(255)
  slug                     String                     @unique(map: "uq_usuarios_slug") @db.VarChar(100)
  telefone                 String                     @db.VarChar(20)
  tipo_usuario             String                     @db.VarChar(20)
  ativo                    Boolean                    @default(true)
  convite_aceito_em        DateTime?                  @db.Timestamptz(6)
  email_verificado_em      DateTime?                  @db.Timestamptz(6)
  ultimo_login_em          DateTime?                  @db.Timestamptz(6)
  criado_em                DateTime                   @default(now()) @db.Timestamptz(6)
  atualizado_em            DateTime                   @default(now()) @db.Timestamptz(6)
  excluido_em              DateTime?                  @db.Timestamptz(6)
  alunos                   alunos?
  anotacoes_internas       anotacoes_internas[]
  avaliacoes_entrega       avaliacoes_entrega[]
  consentimentos_lgpd      consentimentos_lgpd[]
  emails                   emails[]
  encontros                encontros[]
  entregas                 entregas[]
  equipe_membros           equipe_membros[]
  equipes                  equipes[]
  historico_etapas         historico_etapas[]
  log_auditoria            log_auditoria[]
  preferencias_notificacao preferencias_notificacao[]
  tarefas                  tarefas[]
  tokens_acesso            tokens_acesso[]
  tokens_senha             tokens_senha[]
}
