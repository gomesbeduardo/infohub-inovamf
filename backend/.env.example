# Configurações do ambiente.
# Conexão com o Postgres.
# O `?schema=` decide em qual schema do banco as migrations criam tudo — o
# Prisma cria o schema se ele não existir (o usuário precisa de CREATE no banco).
# Qualquer Postgres 13+ vazio serve; `npm run db:migrate` monta o schema.
DATABASE_URL="postgresql://infohub:infohub@localhost:5544/infohub?schema=infohub"
# O `docker-compose.yml` da raiz sobe um Postgres com exatamente esses dados.

PORT=3333
NODE_ENV=development

CORS_ORIGIN="http://localhost:3000"

JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-bytes"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30

# Opcional. Vazio = link relativo ("/convite?token=…") e o front completa com
# a própria origem; só defina se o link precisar sair absoluto.
# INVITE_URL_BASE="http://localhost:3000/convite"
INVITE_TTL_HORAS=72

# Seed de demonstração do G1 (contas @demo.infohub.dev). Remover com
# `npm run seed:demo:purge`. Precisa estar true para o acesso rápido da tela de login.
SEED_DEMO=true
