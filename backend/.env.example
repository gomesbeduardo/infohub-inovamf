# Configurações do ambiente.
# Conexão com o Postgres.
# O `?schema=` decide em qual schema do banco as migrations criam tudo — o
# Prisma cria o schema se ele não existir (o usuário precisa de CREATE no banco).
# DEV LOCAL: qualquer Postgres 13+ vazio; `npm run db:migrate` monta o schema.
DATABASE_URL="postgresql://infohub:infohub@localhost:5544/infohub?schema=infohub"
# PROD (Coolify): use o host interno do serviço de banco e o schema do projeto, ex.:
# DATABASE_URL="postgresql://infohub:senha@postgres:5432/infohub?schema=infohub&sslmode=prefer"

PORT=3333
NODE_ENV=development

CORS_ORIGIN="http://localhost:3000"

JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-bytes"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30

INVITE_URL_BASE="http://localhost:3000/convite"
INVITE_TTL_HORAS=72
