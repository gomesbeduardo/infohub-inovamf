# Conexão com o Postgres.
# PROD: fornecida pelo DBA. O usuário deve ter só DML (SELECT/INSERT/UPDATE/DELETE), sem DDL.
# DEV LOCAL: aponta para o Postgres descartável criado a partir de docs/sql/infohub_schema.sql
#            (ver backend/README.md → "Banco de dev local").
DATABASE_URL="postgresql://infohub:infohub@localhost:5544/infohub?schema=public"

# HTTP
PORT=3333
NODE_ENV=development

# CORS — origem do frontend Next.js
CORS_ORIGIN="http://localhost:3000"

# JWT (access token). Gere um segredo forte: `openssl rand -hex 48`
JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-bytes"
JWT_ACCESS_TTL="15m"
# TTL do refresh (dias). O refresh é persistido em tokens_acesso (SHA-256), não é JWT.
REFRESH_TTL_DAYS=30

# Convite de conta (RF-03): base do link enviado por e-mail e validade do token.
INVITE_URL_BASE="http://localhost:3000/convite"
INVITE_TTL_HORAS=72
