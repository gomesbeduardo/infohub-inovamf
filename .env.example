# Variáveis do deploy — no Coolify tudo isso vai numa lista só, no único
# resource do projeto (Base Directory = /). O `npm start` da raiz sobe backend
# e frontend juntos; só o frontend é exposto.

NODE_ENV=production
# Porta pública (o Coolify injeta). A API fica interna, fixa em 3333.
PORT=3000

# --- Backend ---
# Host interno do Postgres do Coolify, não a URL pública.
DATABASE_URL="postgresql://infohub:senha@postgres:5432/infohub?schema=infohub&sslmode=prefer"
JWT_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-bytes"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30
# Opcional — deixe sem definir. Vazio = link relativo ("/convite?token=…") e o
# front completa com o próprio domínio. Só defina (com o domínio real) se o link
# precisar sair absoluto.
# INVITE_URL_BASE="https://seu-dominio/convite"
INVITE_TTL_HORAS=72

# Seed de demonstração (contas @demo.infohub.dev). O G1 precisa de SEED_DEMO=true:
# sem ele o cenário obrigatório não é criado. Remover depois com
# `npm --prefix backend run seed:demo:purge`.
SEED_DEMO=true

# CORS_ORIGIN não é necessário no deploy padrão: o front chama /api/* no próprio
# domínio, via rewrite do Next. Só defina se um cliente externo for bater na API.
# CORS_ORIGIN="https://outro-dominio"
