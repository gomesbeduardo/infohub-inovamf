# Porta do servidor (o Coolify injeta automaticamente).
PORT=3000
NODE_ENV=production

# Banco de dados — opcional nesta fase.
# Sem DATABASE_URL o app sobe normalmente com os dados mockados em memória.
# DATABASE_URL=postgres://usuario:senha@host:5432/infohub
# Schema alvo dentro do banco (search_path). Padrão: public
# DB_SCHEMA=infohub
# Conexão TLS sem validar o certificado (bancos gerenciados / Coolify interno).
# DATABASE_SSL=false
# Derruba o boot se o banco não responder. Padrão: false
# DATABASE_REQUIRED=false
# DATABASE_POOL_MAX=5
